      "Bash(git ls-files:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(mktemp:*)",
      "Bash(sort:*)",
      "Bash(ls:*)",
      "Bash(tr:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(basename:*)",
      "Bash(echo:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(git fetch:*)",
