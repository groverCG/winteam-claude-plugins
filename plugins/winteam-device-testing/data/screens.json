            }
          ],
          "any": [
            {
              "id": "moduleCaptionTextView",
              "text": "View my shift details"
            },
            {
              "id": "moduleCaptionTextView",
              "text": "View tax forms"
            },
            {
              "id": "moduleCaptionTextView",
              "text": "View time records"
            },
            {
              "id": "moduleCaptionTextView",
              "text": "View my job sites and details"
            }
          ]
        }
      }
