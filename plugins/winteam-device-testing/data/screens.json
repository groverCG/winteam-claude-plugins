    "schedule": {
      "ios": {
        "files": [
          "WinTeam.Mobile.iOS/Views/ViewControllers/Schedule/ScheduleViewController.*",
          "WinTeam.Mobile.iOS/Views/Cells/Schedule/ScheduleViewCell.*"
        ],
        "steps": [
          {
            "action": "tap",
            "predicate": "type == 'XCUIElementTypeStaticText' AND label == 'Schedule'"
          }
        ],
        "anchor": {
          "any": [
            "label == 'You have no upcoming schedules to display'",
            "type == 'XCUIElementTypeCell'"
          ]
        }
      },
      "android": {
        "files": [
          "WinTeam.Mobile.Android/Resources/layout/fragment_my_schedule.xml",
          "WinTeam.Mobile.Android/Resources/layout/item_my_schedule.xml",
          "WinTeam.Mobile.Android/Views/Fragments/Schedule/ScheduleFragment.cs"
        ],
        "steps": [
          {
            "action": "tap",
            "locator": {
              "id": "moduleTitleTextView",
              "text": "Schedule"
            }
          }
        ],
        "anchor": {
          "any": [
            {
              "id": "schedule_date_textView"
            },
            {
              "id": "emptyViewDescriptionTextView",
              "text": "You have no upcoming schedules to display"
            }
          ]
        }
      }
    },
    "tax-forms": {
      "ios": {
        "files": [
          "WinTeam.Mobile.iOS/Views/ViewControllers/TaxForms/**",
          "WinTeam.Mobile.iOS/Views/Cells/TaxForms/**"
        ],
        "steps": [
          {
            "action": "tap",
            "predicate": "type == 'XCUIElementTypeStaticText' AND label == 'Tax Forms'"
          }
        ],
        "anchor": "type == 'XCUIElementTypeStaticText' AND label == 'View and download documents'"
      },
      "android": {
        "files": [
          "WinTeam.Mobile.Android/Resources/layout/fragment_tax_forms.xml",
          "WinTeam.Mobile.Android/Resources/layout/item_tax_form*.xml",
          "WinTeam.Mobile.Android/Resources/layout/fragment_pay_landing_page.xml",
          "WinTeam.Mobile.Android/Views/Fragments/TaxForms/**",
          "WinTeam.Mobile.Android/Views/Fragments/PayLandingPageFragment.cs"
        ],
        "steps": [
          {
            "action": "tap",
            "locator": {
              "id": "moduleTitleTextView",
              "textMatches": "Pay.*|Benefits|Tax Forms"
            }
          },
          {
            "action": "tap",
            "locator": {
              "id": "taxesCardView"
            }
          }
        ],
        "anchor": {
          "all": [
            {
              "id": "date_range_AutocompleteTextView"
            }
          ],
          "any": [
            {
              "id": "taxName_TextView"
            },
            {
              "id": "emptyViewTitleTextView",
              "text": "No tax forms"
            }
          ]
        }
      }
    },
    "jobs": {
      "ios": {
        "files": [
          "WinTeam.Mobile.iOS/Views/ViewControllers/Jobs/JobListViewController.*",
          "WinTeam.Mobile.iOS/Views/ViewControllers/Jobs/JobListTableViewSource.cs",
          "WinTeam.Mobile.iOS/Views/Cells/Jobs/JobsListItemCell.*",
          "WinTeam.Mobile.iOS/Views/Cells/Jobs/JobItemCell.cs"
        ],
        "steps": [
          {
            "action": "tap",
            "predicate": "type == 'XCUIElementTypeStaticText' AND label == 'Jobs'",
            "settle": 3.0
          }
        ],
        "anchor": {
          "any": [
            "type == 'XCUIElementTypeSearchField' AND label == 'Search by name or number'",
            "type == 'XCUIElementTypeCell'"
          ]
        }
      },
      "android": {
        "files": [
          "WinTeam.Mobile.Android/Resources/layout/fragment_job_list.xml",
          "WinTeam.Mobile.Android/Resources/layout/item_job_list.xml",
          "WinTeam.Mobile.Android/Views/Fragments/Jobs/JobListFragment.cs"
        ],
        "steps": [
          {
            "action": "tap",
            "locator": {
              "id": "moduleTitleTextView",
              "text": "Jobs"
            },
            "settle": 3.0
          }
        ],
        "anchor": {
          "any": [
            {
              "id": "jobSearchView"
            },
            {
              "id": "jobNameTextView"
            }
          ]
        }
