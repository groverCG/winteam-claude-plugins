    },
    "time-clock": {
      "domain": "timeclock",
      "ios": {
        "files": [
          "WinTeam.Mobile.iOS/Views/ViewControllers/TimeLanding/TimeLandingView.*",
          "WinTeam.Mobile.iOS/Views/ViewControllers/TimeLanding/TimePageViewController.cs",
          "WinTeam.Mobile.iOS/Views/ViewControllers/TimeLanding/Punches/TimeClockView.*",
          "WinTeam.Mobile.iOS/Views/ViewControllers/TimeLanding/Punches/Buttons/**"
        ],
        "steps": [
          {
            "action": "tap",
            "predicate": "type == 'XCUIElementTypeButton' AND label == 'Time'",
            "settle": 3.0
          },
          {
            "action": "tap",
            "predicate": "type == 'XCUIElementTypeStaticText' AND label == 'Time clock'"
          }
        ],
        "anchor": "type == 'XCUIElementTypeButton' AND label == 'Clock in'"
      },
      "android": {
        "files": [
          "WinTeam.Mobile.Android/Resources/layout/fragment_time_landing.xml",
          "WinTeam.Mobile.Android/Views/Fragments/TimeLanding/TimeLandingFragment.cs",
          "WinTeam.Mobile.Android/Resources/layout/fragment_time_clock.xml",
          "WinTeam.Mobile.Android/Resources/layout/loading_button.xml",
          "WinTeam.Mobile.Android/Views/Fragments/TimeLanding/Punches/TimeClockFragment.cs",
          "WinTeam.Mobile.Android/Views/Reusable/LoadingButton.cs"
        ],
        "steps": [
          {
            "action": "tap",
            "locator": {
              "id": "time"
            },
            "settle": 3.0
          },
          {
            "action": "tap",
            "locator": {
              "class": "android.widget.LinearLayout",
              "desc": "Time clock"
            },
            "settle": 3.0,
            "expect": {
              "class": "android.widget.LinearLayout",
              "desc": "Time clock",
              "selected": true
            }
          }
        ],
        "anchor": {
          "id": "primary_suggested_punch_action_MaterialButton"
        }
      }
    },
    "punch-log": {
      "ios": {
        "files": [
          "WinTeam.Mobile.iOS/Views/ViewControllers/TimeLanding/Punches/PunchLogView.*",
