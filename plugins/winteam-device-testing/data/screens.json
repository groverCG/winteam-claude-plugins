          "any": [
            "label == 'View my shift details'",
            "label == 'View tax forms'",
            "label == 'View time records'",
            "label == 'View my job sites and details'"
          ]
        }
      },
      "android": {
        "files": [
          "WinTeam.Mobile.Android/Resources/layout/fragment_home.xml",
          "WinTeam.Mobile.Android/Resources/layout/view_home_module_button.xml",
          "WinTeam.Mobile.Android/Resources/layout/fragment_dashboard.xml",
          "WinTeam.Mobile.Android/Views/Fragments/Home/HomeFragment.cs",
          "WinTeam.Mobile.Android/Views/Fragments/Home/HomeContentFragment.cs",
          "WinTeam.Mobile.Android/Views/Reusable/HomeModuleButton.cs",
          "WinTeam.Mobile.Android/Views/Fragments/Dashboard/DashboardFragment.cs"
        ],
        "steps": [],
        "anchor": {
          "all": [
            {
              "class": "android.widget.ImageButton",
