        ],
        "steps": [
          {
            "action": "tap",
            "locator": {
              "id": "time"
            },
            "settle": 3.0
          },
          {
            "action": "tap",
            "locator": {
              "class": "android.widget.LinearLayout",
              "desc": "Punch log"
            },
            "settle": 3.0,
            "expect": {
              "class": "android.widget.LinearLayout",
              "desc": "Punch log",
              "selected": true
